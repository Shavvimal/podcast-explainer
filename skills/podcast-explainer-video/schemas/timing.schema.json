{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "timing.schema.json",
  "title": "podcast-explainer-video timing.json",
  "description": "Turn-level timing written by tts.py; align.mjs adds words[], asr[], matchRate, alignedAudioSha and alignment. All times are integer milliseconds from the start of audio/episode.wav. Extra fields from tts.py (hash, timingSource, chunk) are allowed.",
  "type": "object",
  "required": [
    "version",
    "model",
    "mode",
    "sampleRate",
    "durationMs",
    "turns"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "model": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "per-turn",
        "chunk",
        "placeholder"
      ]
    },
    "scratch": {
      "type": "boolean"
    },
    "sampleRate": {
      "type": "integer",
      "minimum": 8000
    },
    "gapMs": {
      "type": "integer",
      "minimum": 0
    },
    "tailPadMs": {
      "type": "integer",
      "minimum": 0
    },
    "leadMs": {
      "type": "integer",
      "minimum": 0
    },
    "durationMs": {
      "type": "integer",
      "minimum": 1
    },
    "chunks": {
      "type": "array",
      "description": "Optional. Chunk files and their start in episode.wav, for turns that share one audio file.",
      "items": {
        "type": "object",
        "required": [
          "file",
          "startMs"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "startMs": {
            "type": "integer",
            "minimum": 0
          },
          "endMs": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "matchRate"
      ],
      "properties": {
        "engine": {
          "type": "string",
          "enum": [
            "whisper.cpp",
            "estimated"
          ]
        },
        "whisperCpp": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "matchRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "alignedAt": {
          "type": "string"
        },
        "draft": {
          "type": "boolean",
          "description": "true when any word time is estimated (align.mjs --estimate-only or a whisper failure). A draft never ships: qc.py audio.fidelity fails."
        }
      }
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/turn"
      }
    },
    "experimental": {
      "type": "boolean",
      "description": "true when tts.py ran the experimental --mode chunk."
    },
    "lengthOverride": {
      "type": "object",
      "required": ["reason", "predictedSec", "problems"],
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "predictedSec": { "type": "number" },
        "problems": { "type": "array", "items": { "type": "string" } }
      },
      "description": "Written by tts.py when --allow-over-length REASON paid for audio although pe_common.length_check reported an error (codex round 4, Q08)."
    }
  },
  "$defs": {
    "turn": {
      "type": "object",
      "required": [
        "id",
        "speaker",
        "segment",
        "file",
        "startMs",
        "endMs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^t[0-9]{2,3}$"
        },
        "speaker": {
          "type": "string"
        },
        "segment": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "endMs": {
          "type": "integer",
          "minimum": 0
        },
        "matchRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "words": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/word"
          }
        },
        "holdAfterMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15000,
          "description": "Silence inserted right after this turn's speech (script.json holdAfterMs), before the normal gap or tail pad; the next turn starts after both."
        },
        "audioSha": {
          "type": "string",
          "description": "Digest of the take this turn's audio came from (tts.py). A --retake of unchanged text changes it."
        },
        "alignedAudioSha": {
          "type": [
            "string",
            "null"
          ],
          "description": "audioSha of the take align.mjs aligned words[] to. Must equal audioSha, else the words are stale."
        },
        "asr": {
          "type": "array",
          "description": "Raw ASR words as heard (ASR spelling, not snapped to the script), on the episode clock. fidelity.py compares them with the script.",
          "items": {
            "type": "object",
            "required": [
              "text",
              "startMs",
              "endMs"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "startMs": {
                "type": "integer"
              },
              "endMs": {
                "type": "integer"
              }
            }
          }
        },
        "holdStartMs": {
          "type": "integer",
          "minimum": 0,
          "description": "Start of the pause hold: the end of the turn's speech. The gap or tail pad follows the hold."
        },
        "holdEndMs": {
          "type": "integer",
          "minimum": 0,
          "description": "holdStartMs + holdAfterMs."
        }
      }
    },
    "word": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "startMs",
        "endMs",
        "source"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "Script spelling, not the ASR spelling."
        },
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "endMs": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "type": "string",
          "enum": [
            "asr",
            "interpolated",
            "estimated"
          ]
        }
      }
    }
  }
}
