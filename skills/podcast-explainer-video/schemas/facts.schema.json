{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "facts.schema.json",
  "title": "podcast-explainer-video facts.json (claim ledger)",
  "description": "Every number, named entity, causal claim and negation the episode states. validate_script.py matches every number in a turn against facts[].numbers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "concept", "sources", "facts"],
  "properties": {
    "version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "concept": {"type": "string", "minLength": 1, "maxLength": 300},
    "sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/source"}
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/fact"}
    },
    "misconceptions": {
      "type": "array",
      "items": {"$ref": "#/$defs/misconception"}
    },
    "analogies": {
      "type": "array",
      "items": {"$ref": "#/$defs/analogy"}
    },
    "openQuestions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "description": "Ambiguities in the source that the learner must decide at gate 1."
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "retrieved"],
      "properties": {
        "id": {"type": "string", "pattern": "^s[0-9]+$"},
        "title": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https?://"},
        "path": {"type": "string", "minLength": 1, "description": "Local document path: a file the learner gave, or the saved scrape of a web source (research/sources/s<N>-<name>.md)."},
        "retrieved": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "claim", "numbers"],
      "properties": {
        "id": {"type": "string", "pattern": "^f[0-9]+$"},
        "kind": {"type": "string", "enum": ["sourced", "arithmetic", "illustrative"]},
        "claim": {"type": "string", "minLength": 1, "maxLength": 400},
        "numbers": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 40},
          "description": "Each number exactly as a turn may write it (\"16\", \"0.75\", \"a million\"). Empty when the claim has no number."
        },
        "polarity": {"type": "string", "enum": ["positive", "negative"], "description": "Set negative for not/never/no claims so the judge checks the polarity against the quote."},
        "sourceId": {"type": "string", "pattern": "^s[0-9]+$"},
        "quote": {"type": "string", "minLength": 1, "description": "Verbatim span from the source."},
        "derivedFrom": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^f[0-9]+$"}},
        "working": {"type": "string", "minLength": 1, "description": "The arithmetic, for example \"16 x 0.75 = 12\"."},
        "label": {"type": "string", "enum": ["Example data", "Illustrative"], "description": "On-screen label for an illustrative number."},
        "span": {"type": "object", "additionalProperties": false, "required": ["file"], "description": "W16: where the quote sits in the saved copy of the source (research/sources/), so a reviewer can check it.",
                 "properties": {"file": {"type": "string", "minLength": 1}, "line": {"type": "integer", "minimum": 1}}}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "sourced"}}}, "then": {"required": ["sourceId", "quote"]}},
        {"if": {"properties": {"kind": {"const": "arithmetic"}}}, "then": {"required": ["derivedFrom", "working"]}},
        {"if": {"properties": {"kind": {"const": "illustrative"}}}, "then": {"required": ["label"]}}
      ]
    },
    "misconception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "correction"],
      "properties": {
        "id": {"type": "string", "pattern": "^m[0-9]+$"},
        "statement": {"type": "string", "minLength": 1},
        "correction": {"type": "string", "minLength": 1},
        "factIds": {"type": "array", "items": {"type": "string", "pattern": "^f[0-9]+$"}},
        "sourceId": {"type": "string", "pattern": "^s[0-9]+$"}
      }
    },
    "analogy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "analogy", "breaksWhere"],
      "properties": {
        "id": {"type": "string", "pattern": "^a[0-9]+$"},
        "analogy": {"type": "string", "minLength": 1},
        "breaksWhere": {"type": "string", "minLength": 1}
      }
    }
  }
}
